# ProxyNode 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ===========================================
# Master Server 配置
# ===========================================

# Master Server 监听地址（0.0.0.0 表示监听所有网络接口）
MASTER_HOST=0.0.0.0

# Master Server API 端口
MASTER_PORT=3000

# Master Server HTTP 代理端口
MASTER_HTTP_PROXY_PORT=8080

# Master Server SOCKS5 代理端口
MASTER_SOCKS5_PROXY_PORT=1080

# 节点选择策略 (round_robin | least_connections | region_priority)
NODE_SELECTION_STRATEGY=least_connections

# 备用策略
NODE_SELECTION_FALLBACK=round_robin

# 节点超时时间（毫秒）
NODE_TIMEOUT=30000

# ===========================================
# Node Server 配置
# ===========================================

# Node Server 监听地址（0.0.0.0 表示监听所有网络接口）
NODE_HOST=0.0.0.0

# Node Server HTTP 代理端口
NODE_HTTP_PORT=8081

# Node Server SOCKS5 代理端口
NODE_SOCKS5_PORT=1081

# Node 名称
NODE_NAME=node-001

# Node 所在区域
NODE_REGION=local

# Master Server 地址（Node 连接 Master 使用）
# 注意：如果 Node 和 Master 在不同机器上，请将 localhost 改为 Master 的实际 IP
MASTER_URL=http://localhost:3000

# Master Server WebSocket 地址
MASTER_WS_URL=ws://localhost:3000/ws

# 监控数据上报间隔（毫秒）
MONITOR_REPORT_INTERVAL=30000

# 节点注册重试配置
# 最大重试次数（-1 表示无限重试，推荐）
NODE_REGISTER_MAX_RETRIES=-1
# 初始重试延迟（毫秒）
NODE_REGISTER_INITIAL_DELAY=5000
